*.prof
*.pprof
*.trace
*.exe
*.syso

# Frontend (Vue + Vite). dist/ is build output embedded by main.go; only the placeholder is
# tracked so `go vet` and `go test` work before the frontend has been built.
node_modules/
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/dist-web/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Browser/UI test output (Playwright etc.)
test-results/
playwright-report/
blob-report/
playwright/.cache/

