# harper-pad-admin. Build context is backend/. Multi-arch: the build stage always runs on the build host's own platform and
# cross-compiles, so no emulation is needed for arm64.
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.26-trixie AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/harper-pad-admin ./cmd/harper-pad-admin

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/harper-pad-admin /harper-pad-admin
USER 65532:65532
EXPOSE 9001
ENTRYPOINT ["/harper-pad-admin"]
CMD ["serve"]
