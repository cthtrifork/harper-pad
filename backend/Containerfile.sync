# harper-pad-sync. Build context is backend/. Image platform: linux/amd64 only. The build stage runs on the build host's own
# platform and cross-compiles for TARGETARCH.
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.26-trixie AS build
ARG TARGETOS TARGETARCH
# The release shown on the API documentation page; "dev" when empty.
ARG APP_VERSION=""
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=${APP_VERSION:-dev}" -o /out/harper-pad-sync ./cmd/harper-pad-sync

FROM gcr.io/distroless/static-debian12:nonroot
# Set by the release (and backend-image.yml); empty in a plain local build.
ARG GIT_SHA=""
ARG APP_VERSION=""
LABEL org.opencontainers.image.title="Harper Pad sync" \
      org.opencontainers.image.description="Harper Pad sync service: stores the drafts of the optional sync." \
      org.opencontainers.image.source="https://github.com/cthtrifork/harper-pad" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${APP_VERSION}"
COPY --from=build /out/harper-pad-sync /harper-pad-sync
USER 65532:65532
EXPOSE 9000 9102
ENTRYPOINT ["/harper-pad-sync"]
CMD ["serve"]
