{
  "name": "harper-pad-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@wailsio/runtime": "3.1.0",
    "harper.js": "^3.0.0",
    "idb": "^8.0.4",
    "marked": "^18.1.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.14"
  }
}
