{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!dist-web", "!bindings", "!package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "html": { "experimentalFullSupportEnabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "style": "off",
      "complexity": { "noImportantStyles": "off" },
      "suspicious": { "noAssignInExpressions": "off", "useIterableCallbackReturn": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["index.html"],
      "html": { "formatter": { "enabled": true } }
    },
    {
      "includes": ["**/*.vue"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ]
}
