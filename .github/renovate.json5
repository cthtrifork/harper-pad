{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  labels: [
    'dependencies',
  ],
  semanticCommits: 'enabled',
  semanticCommitType: 'deps',
  semanticCommitScope: null,
  minimumReleaseAge: '2 days',
  internalChecksFilter: 'strict',
  postUpdateOptions: [
    'gomodTidy',
  ],
  allowedCommands: [
    '^scripts/update-htmx\\.sh [0-9]+\\.[0-9]+\\.[0-9]+$',
  ],
  platformCommit: 'enabled',
  dependencyDashboard: {
    enabled: true,
    title: 'Dependency Dashboard',
    labels: [
      'dependencies',
    ],
  },
  osvVulnerabilityAlerts: true,
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
    semanticCommitType: 'security',
  },
  packageRules: [
    {
      matchPackageNames: [
        'typescript',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      automerge: true,
      minimumReleaseAge: '2 days',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'actions',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'go-minor',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'frontend-minor',
    },
    {
      matchPackageNames: [
        'harper.js',
      ],
      automerge: false,
      groupName: null,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      groupName: 'dev tools',
    },
    {
      matchPackageNames: [
        'golangci/golangci-lint',
        'golangci/golangci-lint-action',
      ],
      groupName: 'golangci-lint',
    },
    {
      matchDepNames: [
        'go',
        'golang',
        'docker.io/library/golang',
        'mirror.gcr.io/library/golang',
      ],
      groupName: 'go toolchain',
      automerge: false,
    },
    {
      matchDepNames: [
        'nodejs',
        'node',
        'docker.io/library/node',
        'mirror.gcr.io/library/node',
      ],
      groupName: 'node',
      automerge: false,
    },
    {
      matchPackageNames: [
        'github.com/wailsapp/wails/v3',
        '@wailsio/runtime',
      ],
      groupName: 'wails',
    },
    {
      matchDepNames: [
        'htmx.org',
      ],
      automerge: false,
      postUpgradeTasks: {
        commands: [
          'scripts/update-htmx.sh {{{newVersion}}}',
        ],
        fileFilters: [
          'backend/internal/admin/web/static/htmx.*',
        ],
        executionMode: 'update',
      },
    },
    {
      matchDatasources: [
        'github-runners',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'renovate',
        'renovatebot/github-action',
      ],
      automerge: true,
      groupName: null,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Makefile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?\\S+\\s*(?::=|=|:)\\s*[\'"]?(?<currentValue>[^\\s\'"]+)',
      ],
    },
  ],
}
